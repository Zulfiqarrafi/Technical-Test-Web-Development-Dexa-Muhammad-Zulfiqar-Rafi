# Server & Gateway
PORT=3000
MS_EMPLOYEE_HOST=127.0.0.1
MS_EMPLOYEE_PORT=4001
MS_ATTENDANCE_HOST=127.0.0.1
MS_ATTENDANCE_PORT=4002
STANDALONE_MICROSERVICES=false

# JWT Auth
JWT_SECRET=ganti-dengan-secret-key-production
JWT_EXPIRES_IN=12h

# Database Configuration
# Supported DB_TYPE: mysql | oracle | postgres | mssql | sqlite
# Contoh MySQL (XAMPP / Laragon / Docker):
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=dexa_wfh_db
DB_SYNCHRONIZE=true
DB_FALLBACK_LOCAL=true

# Contoh Oracle:
# DB_TYPE=oracle
# DB_HOST=127.0.0.1
# DB_PORT=1521
# DB_USERNAME=system
# DB_PASSWORD=oracle
# DB_SERVICE_NAME=XEPDB1

# Contoh PostgreSQL:
# DB_TYPE=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=dexa_wfh_db

# Jam batas keterlambatan WFH (format HH:mm WIB)
WORK_START_LIMIT=08:30

